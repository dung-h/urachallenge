# Copy this file to .env and fill in your local values.

SERPER_API_KEY=your_serper_api_key

# Production OpenAI-compatible server:
# bash scripts/start_vllm_server.sh
URA_LLM_BASE_URL=http://127.0.0.1:8001/v1
URA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
URA_LLM_TIMEOUT=120

# Alternative OpenAI-compatible alias:
OPENAI_BASE_URL=

# Explicit opt-in heuristic fallback (0 = fail strictly with 503 if vLLM is offline [default], 1 = fallback to heuristics):
URA_ALLOW_HEURISTIC_FALLBACK=0

# Development only. Production should keep this disabled.
URA_ALLOW_MOCK_LLM_SERVER=0
