# Copy this file to .env and fill in your local values.

SERPER_API_KEY=your_serper_api_key

# vLLM OpenAI-compatible example:
# python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-7B-Instruct --host 127.0.0.1 --port 8001
URA_LLM_BACKEND=openai-compatible
URA_LLM_BASE_URL=http://127.0.0.1:8001/v1
URA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
URA_LLM_TIMEOUT=120

# Alternative OpenAI-compatible alias:
OPENAI_BASE_URL=
