# Python caches
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local env/secrets
.env
.env.*
!.env.example

# Logs and scratch files
logs/
*.log
*.tmp
*.swp
*.swo
*.bak
scratch/

# Runtime/generated outputs
outputs/
outputs/disagreements/
outputs/traces/

# Reports: keep tracked canonical reports, ignore new/generated local reports by default.
reports/*
!reports/ablation_eval_cases.jsonl
!reports/ablation_eval_summary.json
!reports/four_layer_quality_report.md
!reports/opencode_exact_agent_integration_report.md
!reports/quality_eval_error_cases.jsonl
!reports/quality_eval_summary.md
!reports/trace_grounded_verified_qa_report.md

# Local data/model/vendor downloads
archive/
clones/
datasets/
models/
third_party/

# Large/backend local artifacts
*.gguf
*.safetensors
*.pt
*.pth
*.bin
*.tar.gz
*.zip

# OpenCode local package artifacts
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Agent tool state (local only, not for sync)
.claude/
.kiro/

# Throwaway / diagnostic scripts (per AGENTS.md §23)
_tmp_*.py
scripts/_diag_*.py
scripts/_tmp_*.sh

# Notebook checkpoints
.ipynb_checkpoints/

# One-off request files
test_req.json

# Reports: add canonical session reports (override reports/* above)
!reports/deep_test_planner_summary.md
!reports/deep_test_planner_cases.jsonl
!reports/session_method_centric_full_summary.md
!reports/dataset_correction_report.md
